<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Spreadsheet the rules are written in. An absolute path is used as it is; a relative one is looked
         up in the current directory first, then from the folder of the executable upwards - so the tool
         works both from the repository root and from a double-click on bin\. -->
    <add key="InputWorkbook" value="templates\ValidationRules.Template.xlsx" />

    <!-- Where the generated configuration lands. A relative folder is created next to the spreadsheet. -->
    <add key="OutputFolder" value="Validation Rules out" />

    <!-- Json = one file per table, Excel = a copy of the input with the generated rule on each line,
         Both = the two of them. -->
    <add key="OutputFormat" value="Both" />
  </appSettings>
</configuration>
